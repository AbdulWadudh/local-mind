{
  "name": "localmind",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first Agentic RAG for TypeScript: chunking, LanceDB vector storage, grounded generation, tool-calling retrieval agents, and a self-correcting verify workflow. Built on the Vercel AI SDK.",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:studio": "tsc -p studio/tsconfig.json --noEmit",
    "typecheck:all": "bun run typecheck && bun run typecheck:studio",
    "build": "bun run build:js && bun run build:types && bun run studio:build",
    "build:js": "bun build ./src/index.ts ./src/sources/index.ts ./src/studio/router.ts ./src/studio/protocol.ts ./src/testing/index.ts ./src/cli/localmind.ts --outdir dist --target bun --format esm --splitting --external @lancedb/lancedb --external apache-arrow --external ai --external ai-sdk-ollama --external @openrouter/ai-sdk-provider --external zod --external hono --external yaml",
    "build:types": "tsc -p tsconfig.build.json && bun run scripts/fix-dts-extensions.ts",
    "studio": "bun run src/cli/studio.ts",
    "studio:api": "bun run src/cli/studio.ts --api-only",
    "studio:build": "vite build --config studio/vite.config.ts",
    "studio:dev": "vite --config studio/vite.config.ts",
    "doctor": "bun run src/cli/doctor.ts",
    "ingest": "bun run src/cli/ingest.ts",
    "search": "bun run src/cli/search.ts",
    "ask": "bun run src/cli/ask.ts",
    "agent": "bun run src/cli/agent.ts",
    "research": "bun run src/cli/research.ts",
    "verify": "bun run src/cli/verify.ts",
    "verify:offline": "bun run src/cli/verify.ts --offline"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.37.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.70",
    "ai-sdk-ollama": "^4.2.0",
    "apache-arrow": "^18.1.0",
    "hono": "^4.13.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "shadcn": "^4.18.0",
    "tw-animate-css": "^1.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "postgres": "^3.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "license": "MIT",
  "keywords": [
    "rag",
    "agentic-rag",
    "vector-database",
    "lancedb",
    "vercel-ai-sdk",
    "embeddings",
    "retrieval",
    "ollama",
    "openrouter",
    "local-first",
    "llm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./studio": {
      "types": "./dist/studio/router.d.ts",
      "import": "./dist/studio/router.js"
    },
    "./protocol": {
      "types": "./dist/studio/protocol.d.ts",
      "import": "./dist/studio/protocol.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "sideEffects": false,
  "bin": {
    "localmind": "./dist/cli/localmind.js"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": ">=3",
    "@aws-sdk/client-s3": ">=3",
    "@elastic/elasticsearch": ">=8",
    "ioredis": ">=5",
    "mongodb": ">=6",
    "mysql2": ">=3",
    "postgres": "3.4.5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@elastic/elasticsearch": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  }
}