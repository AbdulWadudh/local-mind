# ─────────────────────────────────────────────────────────────────────────────
# LocalMind configuration. Copy to `.env` — Bun loads it automatically.
# Every value has a default; an empty .env runs fully local against Ollama.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chat / reasoning model ───────────────────────────────────────────────────
# "ollama"      → fully local, zero cloud keys (default)
# "openrouter"  → one key, hundreds of models
LOCALMIND_CHAT_PROVIDER=ollama

# Defaults: ollama → "llama3.1:8b"
#           openrouter → "nvidia/nemotron-3-super-120b-a12b:free"
#
# The OpenRouter default is a PINNED free model (262k context, verified to do
# tool calls + structured outputs, which stages 3 and 4 require).
#
# "openrouter/free" is the auto-router: also free, but it picks a random free
# model per request, and some of them ignore the prompt entirely (an observed
# grounded-answer response was the single line "User Safety: safe"). Good for
# watching the defensive layers engage; bad as a default.
# Other verified free slugs: openai/gpt-oss-20b:free, google/gemma-4-26b-a4b-it:free
# LOCALMIND_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Model used for the cheap, high-volume structured calls in Stage 4
# (relevance grading, groundedness verification). Defaults to the chat model.
# LOCALMIND_GRADER_MODEL=llama3.1:8b

# ── Embedding model ──────────────────────────────────────────────────────────
# "ollama" or "openrouter" (default)
LOCALMIND_EMBEDDING_PROVIDER=openrouter
# Defaults: ollama → "nomic-embed-text" | openrouter → "nvidia/nemotron-3-embed-1b:free"
# LOCALMIND_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# ── Provider endpoints / credentials ─────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required only when a provider above is set to "openrouter".
# OPENROUTER_API_KEY=sk-or-v1-...

# ── Vector store (local-first: a directory on disk, no server) ───────────────
LOCALMIND_DB_PATH=.data/lancedb
LOCALMIND_TABLE=chunks
LOCALMIND_CORPUS_DIR=corpus

# ── Chunking ─────────────────────────────────────────────────────────────────
LOCALMIND_CHUNK_CHARS=1200
LOCALMIND_CHUNK_OVERLAP=180

# ── Retrieval / generation budgets ───────────────────────────────────────────
LOCALMIND_TOP_K=6
LOCALMIND_MIN_SCORE=0.25
LOCALMIND_MAX_CONTEXT_TOKENS=3000
LOCALMIND_MAX_AGENT_STEPS=8

# ── Stage 4 web-search fallback ──────────────────────────────────────────
# "offline"    → deterministic local fixtures, no network (default)
# "ollama"     → Ollama's hosted web_search tool (needs OLLAMA_API_KEY)
# "openrouter" → OpenRouter ":online" web plugin
LOCALMIND_WEB_SEARCH=offline
# OLLAMA_API_KEY=
